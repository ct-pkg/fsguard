namespace fsguard;

#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>

#include "fsguard/FsGuardOps.shim.h"

/*
 * 错误码（R-02）：10 个成员，名字与数值冻结，后续只追加。
 * 不用 #define：CT 没有预处理器，`.h.ct` 里的常量必须是 pub enum。
 */
pub enum FsErrCode {
    FS_OK = 0,
    FS_ERR_NOT_FOUND = 1,
    FS_ERR_PERMISSION = 2,
    FS_ERR_OUT_OF_BOUNDS = 3,
    FS_ERR_DENIED_PATTERN = 4,
    FS_ERR_IS_DIR = 5,
    FS_ERR_NOT_DIR = 6,
    FS_ERR_BUFFER_TOO_SMALL = 7,
    FS_ERR_IO = 8,
    FS_ERR_OOM = 9
}

/* 遍历回调（R-07）：entry 是借用，生命周期到回调返回为止。 */
pub typedef int (*FsWalkCb)(char *entry, int is_dir, void *ud);

/* last_error() 的返回体；由 FsGuard 独占，调用方不得 free。 */
pub struct FsError {
    int code;
    char *path;
    char *message;
}

/*
 * 有状态策略（R-09 的 check 部分）。
 *
 * `_policy_enabled` 不是字段：策略是否启用由三个指针派生
 * `(_root != 0 || _allow_prefix != 0 || _deny_pattern != 0)`。
 */
pub struct FsGuard {
    char *_root;
    char *_allow_prefix;
    char *_deny_pattern;
    int _max_depth;
    FsError _last_error;
    int _has_error;
} use Drop;

static char *fsg_dup(char *s)
{
    size_t n;
    char *p;

    if (s == 0) return 0;
    n = strlen(s) + 1;
    p = malloc(n);
    if (p == 0) return 0;
    memcpy(p, s, n);
    return p;
}

static void fsg_error_clear(FsGuard *g)
{
    free(g->_last_error.path);
    free(g->_last_error.message);
    g->_last_error.code = 0;
    g->_last_error.path = 0;
    g->_last_error.message = 0;
    g->_has_error = 0;
}

static int fsg_error_set(FsGuard *g, int code, char *path, char *message)
{
    g->_last_error.code = code;
    g->_last_error.path = fsg_dup(path != 0 ? path : "");
    g->_last_error.message = fsg_dup(message != 0 ? message : "fsguard error");
    g->_has_error = 1;
    return code;
}

/* FsGuard::walk 的桥：把每次遍历回调先过一遍 check。 */
struct FsWalkBridge {
    FsGuard *_g;
    FsWalkCb _cb;
    void *_ud;
    int _code;
};

static int fsg_walk_filter(const char *path, int is_dir, void *ctx);
static int fsg_walk_bridge(char *entry, int is_dir, void *ud);

/*
 * R-14：全包唯一的 errno → FS_ERR_* 映射（D-009）。
 * ENOENT→NOT_FOUND；ENOTDIR→NOT_DIR；EACCES/EPERM→PERMISSION；
 * EISDIR→IS_DIR；ELOOP / ENAMETOOLONG / 其余→IO。
 */
static int fsguard_errno_to_code(int e)
{
    switch (e) {
    case ENOENT:
        return FS_ERR_NOT_FOUND;
    case ENOTDIR:
        return FS_ERR_NOT_DIR;
    case EACCES:
    case EPERM:
        return FS_ERR_PERMISSION;
    case EISDIR:
        return FS_ERR_IS_DIR;
    default:
        return FS_ERR_IO;
    }
}

impl FsGuard {
    /*
     * 判定顺序冻结（R-09）：① 规范化 → ② root 段边界 → ③ allow 前缀
     * → ④ deny glob → ⑤ FS_OK。纯词法，不访问文件系统。
     */
    pub int check(char *path)
    {
        char norm[FSGO_PATH_MAX];

        fsg_error_clear(self);
        if (path == 0)
            return fsg_error_set(self, FS_ERR_IO, "", "null path");
        if (fsgo_normalize(path, norm, FSGO_PATH_MAX) != 0)
            return fsg_error_set(self, FS_ERR_IO, "", "path too long or overlapping buffer");
        if (self->_root != 0 && !fsgo_is_under(norm, self->_root))
            return fsg_error_set(self, FS_ERR_OUT_OF_BOUNDS, norm, "path escapes root");
        if (self->_allow_prefix != 0 && !fsgo_is_under(norm, self->_allow_prefix))
            return fsg_error_set(self, FS_ERR_OUT_OF_BOUNDS, norm, "path outside allow prefix");
        if (self->_deny_pattern != 0 && fsgo_match(norm, self->_deny_pattern))
            return fsg_error_set(self, FS_ERR_DENIED_PATTERN, norm, "path matches deny pattern");
        return FS_OK;
    }

    pub int has_error()
    {
        return self->_has_error;
    }

    pub FsError *last_error()
    {
        if (self->_has_error == 0) return 0;
        return &self->_last_error;
    }

    pub void clear_error()
    {
        fsg_error_clear(self);
    }

    pub FsGuard *allow_prefix(char *prefix)
    {
        char norm[FSGO_PATH_MAX];
        char *copy;

        if (prefix == 0) return 0;
        if (prefix[0] == 0) {
            free(self->_allow_prefix);
            self->_allow_prefix = 0;
            return self;
        }
        if (fsgo_normalize(prefix, norm, FSGO_PATH_MAX) != 0) return 0;
        copy = fsg_dup(norm);
        if (copy == 0) return 0;
        free(self->_allow_prefix);
        self->_allow_prefix = copy;
        return self;
    }

    pub FsGuard *deny_pattern(char *glob)
    {
        char *copy;

        if (glob == 0) return 0;
        if (glob[0] == 0) {
            free(self->_deny_pattern);
            self->_deny_pattern = 0;
            return self;
        }
        copy = fsg_dup(glob);
        if (copy == 0) return 0;
        free(self->_deny_pattern);
        self->_deny_pattern = copy;
        return self;
    }

    /* R-10 的深度配置；非法参数返回 NULL 且不动原对象（D-001）。 */
    pub FsGuard *max_depth(int depth)
    {
        if (depth < 0) return 0;
        self->_max_depth = depth;
        return self;
    }

    /*
     * R-12 / Q-2 = A（D-006）：先 check 后 I/O；失败不回滚、不删除，
     * 失败后目标文件内容未定义。成功返回实际字节数（不含 NUL）。
     */
    pub int read_file(char *path, char *buf, int cap)
    {
        char norm[FSGO_PATH_MAX];
        struct stat st;
        char *tmp;
        int fd;
        int got;
        int want;
        int code;

        fsg_error_clear(self);
        if (path == 0 || buf == 0 || cap <= 0)
            return fsg_error_set(self, FS_ERR_IO, "", "invalid argument");
        if (fsgo_normalize(path, norm, FSGO_PATH_MAX) != 0)
            return fsg_error_set(self, FS_ERR_IO, "", "path too long or overlapping buffer");
        code = self->check(norm);
        if (code != FS_OK) return code;

        fd = open(norm, O_RDONLY);
        if (fd < 0)
            return fsg_error_set(self, fsguard_errno_to_code(fsgo_errno()), norm, "open failed");
        if (fstat(fd, &st) != 0) {
            code = fsguard_errno_to_code(fsgo_errno());
            close(fd);
            return fsg_error_set(self, code, norm, "stat failed");
        }
        if (S_ISDIR(st.st_mode)) {
            close(fd);
            return fsg_error_set(self, FS_ERR_IS_DIR, norm, "is a directory");
        }
        want = (int)st.st_size;
        if (want + 1 > cap) {
            close(fd);
            return fsg_error_set(self, FS_ERR_BUFFER_TOO_SMALL, norm, "buffer too small");
        }
        tmp = malloc((size_t)(want > 0 ? want : 1));
        if (tmp == 0) {
            close(fd);
            return fsg_error_set(self, FS_ERR_OOM, norm, "out of memory");
        }
        got = 0;
        while (got < want) {
            ssize_t n = read(fd, tmp + got, (size_t)(want - got));
            if (n < 0) {
                code = fsguard_errno_to_code(fsgo_errno());
                free(tmp);
                close(fd);
                return fsg_error_set(self, code, norm, "read failed");
            }
            if (n == 0) break;
            got += (int)n;
        }
        close(fd);
        memcpy(buf, tmp, (size_t)got);
        buf[got] = 0;
        free(tmp);
        return got;
    }

    /* 成功返回 len；失败只保证错误码，目标内容未定义（D-006）。 */
    pub int write_file(char *path, char *data, int len)
    {
        char norm[FSGO_PATH_MAX];
        struct stat st;
        int fd;
        int put;
        int code;

        fsg_error_clear(self);
        if (path == 0 || len < 0 || (data == 0 && len > 0))
            return fsg_error_set(self, FS_ERR_IO, "", "invalid argument");
        if (fsgo_normalize(path, norm, FSGO_PATH_MAX) != 0)
            return fsg_error_set(self, FS_ERR_IO, "", "path too long or overlapping buffer");
        code = self->check(norm);
        if (code != FS_OK) return code;

        if (stat(norm, &st) == 0 && S_ISDIR(st.st_mode))
            return fsg_error_set(self, FS_ERR_IS_DIR, norm, "is a directory");
        fd = open(norm, O_WRONLY | O_CREAT | O_TRUNC, 0666);
        if (fd < 0)
            return fsg_error_set(self, fsguard_errno_to_code(fsgo_errno()), norm, "open failed");
        put = 0;
        while (put < len) {
            ssize_t n = write(fd, data + put, (size_t)(len - put));
            if (n <= 0) {
                code = n < 0 ? fsguard_errno_to_code(fsgo_errno()) : FS_ERR_IO;
                close(fd);
                return fsg_error_set(self, code, norm, "write failed");
            }
            put += (int)n;
        }
        if (close(fd) != 0)
            return fsg_error_set(self, fsguard_errno_to_code(fsgo_errno()), norm, "close failed");
        return len;
    }

    /* FsGuard 版 read_chunk：先 check，失败时把 errno 写进 last_error。 */
    pub int read_chunk(char *path, long long offset, char *buf, int len)
    {
        char norm[FSGO_PATH_MAX];
        int syserr = -1;
        int code;
        int n;

        fsg_error_clear(self);
        if (path == 0 || (buf == 0 && len > 0) || offset < 0 || len < 0)
            return fsg_error_set(self, FS_ERR_IO, "", "invalid argument");
        if (fsgo_normalize(path, norm, FSGO_PATH_MAX) != 0)
            return fsg_error_set(self, FS_ERR_IO, "", "path too long or overlapping buffer");
        code = self->check(norm);
        if (code != FS_OK) return code;
        if (len == 0) return 0;

        n = fsgo_read_chunk(norm, offset, buf, len, &syserr);
        if (n < 0)
            return fsg_error_set(self, syserr < 0 ? FS_ERR_IO : fsguard_errno_to_code(syserr),
                                 norm, "read chunk failed");
        return n;
    }

    /*
     * R-13：先 check root，再对每个条目 check；越界/命中 deny 的条目
     * 静默剪枝（目录连同整棵子树），不可读目录 fail-closed。
     * 与 char *::walk 共用 fsgo_walk 这一份递归实现。
     */
    pub int walk(char *root, FsWalkCb cb, void *ud)
    {
        char norm[FSGO_PATH_MAX];
        struct FsWalkBridge b;
        int syserr = -1;
        int rc;

        fsg_error_clear(self);
        if (root == 0 || cb == 0)
            return fsg_error_set(self, FS_ERR_IO, "", "invalid argument");
        if (fsgo_normalize(root, norm, FSGO_PATH_MAX) != 0)
            return fsg_error_set(self, FS_ERR_IO, "", "path too long or overlapping buffer");
        rc = self->check(norm);
        if (rc != FS_OK) return rc;

        b._g = self;
        b._cb = cb;
        b._ud = ud;
        b._code = FS_OK;
        rc = fsgo_walk(norm, fsg_walk_bridge, &b, self->_max_depth,
                       fsg_walk_filter, &b, &syserr);
        if (rc < 0)
            return fsg_error_set(self,
                                 b._code != FS_OK ? b._code
                                 : (syserr < 0 ? FS_ERR_IO : fsguard_errno_to_code(syserr)),
                                 norm, "walk failed");
        return rc;
    }
}

static int fsg_walk_filter(const char *path, int is_dir, void *ctx)
{
    struct FsWalkBridge *b;
    int rc;

    (void)is_dir;
    b = ctx;
    rc = b->_g->check((char *)path);
    if (rc == FS_OK) return 0;
    if (rc == FS_ERR_OUT_OF_BOUNDS || rc == FS_ERR_DENIED_PATTERN) return 2;
    b->_code = rc;
    return -1;
}

static int fsg_walk_bridge(char *entry, int is_dir, void *ud)
{
    struct FsWalkBridge *b = ud;
    return b->_cb(entry, is_dir, b->_ud);
}

impl Drop for FsGuard {
    void drop()
    {
        free(self->_root);
        free(self->_allow_prefix);
        free(self->_deny_pattern);
        free(self->_last_error.path);
        free(self->_last_error.message);
    }
}

/*
 * 工厂：ct 0.44.1 不能把 `static FsGuard *new` 声明成可跨单元的静态方法，
 * 因此用自由函数（卡 H-2）。root 为 0 时不做根约束。
 */
pub FsGuard *fsguard_new(char *root);

FsGuard *fsguard_new(char *root)
{
    FsGuard *g;
    char norm[FSGO_PATH_MAX];

    g = malloc(sizeof(FsGuard));
    if (g == 0) return 0;
    g->_root = 0;
    g->_allow_prefix = 0;
    g->_deny_pattern = 0;
    g->_max_depth = 16;
    g->_last_error.code = 0;
    g->_last_error.path = 0;
    g->_last_error.message = 0;
    g->_has_error = 0;

    if (root != 0) {
        if (fsgo_normalize(root, norm, FSGO_PATH_MAX) != 0) {
            free(g);
            return 0;
        }
        g->_root = fsg_dup(norm);
        if (g->_root == 0) {
            free(g);
            return 0;
        }
    }
    return g;
}
