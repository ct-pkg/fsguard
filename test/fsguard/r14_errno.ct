/*
 * R-14 errno → FS_ERR_* 映射：四类夹具 + ELOOP / ENAMETOOLONG 归 IO。
 *
 * $ bash tools/check.sh g3-ph02 r14
 *
 * 映射口径见 D-009：ENOENT→NOT_FOUND；ENOTDIR→NOT_DIR；EACCES/EPERM→PERMISSION；
 * EISDIR→IS_DIR；其余（含 ELOOP、ENAMETOOLONG）→ IO。
 */
import fsguard::FsGuard;
#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>

static int total = 0;
static int failed = 0;

static void check(int cond, char *name)
{
    total = total + 1;
    if (cond) {
        printf("ok %d %s\n", total, name);
    } else {
        failed = failed + 1;
        printf("not ok %d %s\n", total, name);
    }
}

int main(void)
{
    char buf[16];
    char path[128];
    char dir[128];
    char loop[128];
    char nested[160];
    char *longpath;
    FsGuard *g;
    int fd;
    int i;

    strcpy(path, "/tmp/fsguard_ph02_r14.txt");
    strcpy(dir, "/tmp/fsguard_ph02_r14_dir");
    strcpy(loop, "/tmp/fsguard_ph02_r14_loop");
    strcpy(nested, "/tmp/fsguard_ph02_r14.txt/child");
    unlink(path);
    unlink(loop);
    rmdir(dir);
    fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
    if (fd >= 0) close(fd);
    mkdir(dir, 0755);
    symlink(loop, loop);

    g = fsguard::fsguard_new(0);
    check(g->read_file("/tmp/fsguard_ph02_r14_missing", buf, 16) == FS_ERR_NOT_FOUND,
          "ENOENT maps to NOT_FOUND");
    check(g->read_file(nested, buf, 16) == FS_ERR_NOT_DIR, "ENOTDIR maps to NOT_DIR");
    check(g->read_file(dir, buf, 16) == FS_ERR_IS_DIR, "EISDIR maps to IS_DIR");
    check(g->read_file(loop, buf, 16) == FS_ERR_IO, "ELOOP maps to IO");

    if (geteuid() == 0) {
        printf("skip PERMISSION case: running as root\n");
    } else {
        chmod(path, 0);
        check(g->read_file(path, buf, 16) == FS_ERR_PERMISSION, "EACCES maps to PERMISSION");
        chmod(path, 0644);
    }

    longpath = malloc(5000);
    longpath[0] = '/';
    for (i = 1; i < 4999; i++) longpath[i] = 'a';
    longpath[4999] = 0;
    check(g->read_file(longpath, buf, 16) == FS_ERR_IO,
          "over-long path maps to IO (ENAMETOOLONG bucket)");
    free(longpath);

    delete g;
    unlink(path);
    unlink(loop);
    rmdir(dir);
    if (failed == 0) {
        printf("all checks passed\n");
        return 0;
    }
    printf("%d of %d checks failed\n", failed, total);
    return 1;
}
