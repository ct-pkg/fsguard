/*
 * R-05 词法规范化：九行表逐行相等，容量不足不写半截，重叠输入拒绝。
 *
 * $ bash tools/check.sh g3-ph01 r05
 *
 * 口径来自 D-003（绝对路径根处钳住、相对路径保留前导 `..`）。
 * 重叠检测（H-4）比 R-05 判据 4 的原文更严：实现返回 -1 并清空 out。
 */
import fsguard::FsGuardOps;
#include <stdio.h>
#include <string.h>

static int total = 0;
static int failed = 0;

static void check(int cond, char *name)
{
    total = total + 1;
    if (cond) {
        printf("ok %d %s\n", total, name);
    } else {
        failed = failed + 1;
        printf("not ok %d %s\n", total, name);
    }
}

static void expect(char *in, char *want, char *name)
{
    char out[64];
    int rc;
    int ok;
    out[0] = 0;
    rc = in.normalize_to(out, 64);
    ok = rc == 0 && strcmp(out, want) == 0;
    if (!ok) {
        fprintf(stderr, "# %s: rc=%d got [%s] want [%s]\n", name, rc, out, want);
    }
    check(ok, name);
}

int main(void)
{
    char small[4];
    char exact[4];
    char overlap[16];

    expect("src/../a.c", "a.c", "src/../a.c -> a.c");
    expect("./a", "a", "./a -> a");
    expect("a//b", "a/b", "a//b -> a/b");
    expect("a/b/", "a/b", "a/b/ -> a/b");
    expect("/", "/", "/ -> /");
    expect("../etc", "../etc", "../etc -> ../etc");
    expect("/../etc", "/etc", "/../etc -> /etc");
    expect("/tmp/../../../etc", "/etc", "/tmp/../../../etc -> /etc");
    expect("", ".", "empty -> .");

    strcpy(small, "zzz");
    check("a/bc".normalize_to(small, 4) == -1 && small[0] == 0,
          "cap too small returns -1 and out[0] == 0");

    strcpy(exact, "zzz");
    check("a/b".normalize_to(exact, 4) == 0 && strcmp(exact, "a/b") == 0,
          "cap == len+1 succeeds");

    expect("/no/such/./x/../y", "/no/such/y", "nonexistent path still normalises");

    strcpy(overlap, "a/../b");
    check(overlap.normalize_to(overlap, 16) == -1 && overlap[0] == 0,
          "overlapping out/path returns -1 and clears out");

    if (failed == 0) {
        printf("all checks passed\n");
        return 0;
    }
    printf("%d of %d checks failed\n", failed, total);
    return 1;
}
