/*
 * R-10 策略配置：默认深度 16、覆盖语义、空串等价未配置、deny 方言。
 *
 * $ bash tools/check.sh g3-ph03 r10
 */
import fsguard::FsGuard;
#include <stdio.h>
#include <string.h>
#include <sys/stat.h>
#include <unistd.h>

static int total = 0;
static int failed = 0;
static int seen_n = 0;

static void check(int cond, char *name)
{
    total = total + 1;
    if (cond) {
        printf("ok %d %s\n", total, name);
    } else {
        failed = failed + 1;
        printf("not ok %d %s\n", total, name);
    }
}

static void remove_chain(char *base, int n)
{
    char buf[192];
    int i;
    strcpy(buf, base);
    for (i = 0; i < n; i++) {
        int k = (int)strlen(buf);
        snprintf(buf + k, (size_t)(192 - k), "/d%d", i);
    }
    for (i = 0; i < n; i++) {
        int k = (int)strlen(buf) - 1;
        rmdir(buf);
        while (k > 0 && buf[k] != '/') k--;
        buf[k] = 0;
    }
    rmdir(buf);
}

static int count_cb(char *entry, int is_dir, void *ud)
{
    (void)entry;
    (void)is_dir;
    (void)ud;
    seen_n = seen_n + 1;
    return 0;
}

int main(void)
{
    char root[128];
    char p[192];
    int i;
    FsGuard *g;
    int rc;

    strcpy(root, "/tmp/fsguard_ph03_chain");
    remove_chain(root, 17);
    mkdir(root, 0755);
    strcpy(p, root);
    for (i = 0; i < 17; i++) {
        int n = (int)strlen(p);
        snprintf(p + n, (size_t)(192 - n), "/d%d", i);
        mkdir(p, 0755);
    }

    g = fsguard::fsguard_new(root);
    seen_n = 0;
    rc = g->walk(root, count_cb, 0);
    check(rc == 0 && seen_n == 17, "default max_depth 16 stops at 17 entries");
    delete g;

    g = fsguard::fsguard_new(root);
    g->max_depth(3);
    g->max_depth(2);
    seen_n = 0;
    rc = g->walk(root, count_cb, 0);
    check(rc == 0 && seen_n == 3, "last max_depth wins (override, not accumulate)");
    delete g;

    g = fsguard::fsguard_new(0);
    check(g->allow_prefix("/x") == g, "allow_prefix accepts a value");
    check(g->allow_prefix("") == g, "allow_prefix('') clears the policy");
    check(g->check("/etc/passwd") == FS_OK, "empty allow_prefix means unconfigured");
    check(g->deny_pattern("/etc/*") == g, "deny_pattern accepts a value");
    check(g->check("/etc/passwd") == FS_ERR_DENIED_PATTERN, "deny applies before clearing");
    check(g->deny_pattern("") == g, "deny_pattern('') clears the policy");
    check(g->check("/etc/passwd") == FS_OK, "empty deny_pattern means unconfigured");
    delete g;

    g = fsguard::fsguard_new(0);
    g->allow_prefix("/ws");
    g->deny_pattern("/ws/secret/*.key");
    check(g->check("/ws/secret/a.key") == FS_ERR_DENIED_PATTERN,
          "deny glob matches a direct child");
    check(g->check("/ws/secret/deep/a.key") == FS_OK,
          "deny glob does not cross a slash");
    check(g->check("/ws/secret/A.KEY") == FS_OK, "deny glob is case sensitive");
    check(g->check("/other/a.key") == FS_ERR_OUT_OF_BOUNDS, "allow still wins first");
    delete g;

    if (failed == 0) {
        printf("all checks passed\n");
        return 0;
    }
    printf("%d of %d checks failed\n", failed, total);
    return 1;
}
