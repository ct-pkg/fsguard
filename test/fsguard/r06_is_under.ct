/*
 * R-06 路径段边界：按段比较，不是字符串前缀。
 *
 * $ bash tools/check.sh g3-ph01 r06
 *
 * 只断言绝对路径与同种路径（判据 2–5）。判据 1 首例
 * `src/a.c` vs `/workspace/src` 与段边界定义冲突，按卡 H-3 记为 0 并标注待裁。
 */
import fsguard::FsGuardOps;
#include <stdio.h>

static int total = 0;
static int failed = 0;

static void check(int cond, char *name)
{
    total = total + 1;
    if (cond) {
        printf("ok %d %s\n", total, name);
    } else {
        failed = failed + 1;
        printf("not ok %d %s\n", total, name);
    }
}

int main(void)
{
    check("/workspace/src/a.c".is_under("/workspace/src") == 1,
          "child path is under its prefix");
    check("/workspace/src2/a.c".is_under("/workspace/src") == 0,
          "segment boundary rejects src2");
    check("/workspace/src".is_under("/workspace/src") == 1,
          "equal path is under itself");
    check("/workspace/src/a.c".is_under("/workspace/src/") == 1,
          "trailing slash on prefix does not change the answer");
    check("src2/a.c".is_under("/workspace/src") == 0,
          "relative vs absolute is not under (D-002)");
    check("../etc".is_under("/workspace") == 0,
          "relative leading .. is not under an absolute prefix");
    check("src/a.c".is_under("/workspace/src") == 0,
          "H-3: R-06 case 1 first example is 0 under segment rules");
    check("/workspace/src".is_under("/workspace") == 1,
          "prefix itself is under a shorter prefix");
    check("/workspace".is_under("/workspace/src") == 0,
          "shorter path is not under a longer prefix");

    if (failed == 0) {
        printf("all checks passed\n");
        return 0;
    }
    printf("%d of %d checks failed\n", failed, total);
    return 1;
}
