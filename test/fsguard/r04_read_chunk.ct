/*
 * R-04 char *::read_chunk：按 offset 分块读、EOF 不报错、负参数 -1、二进制安全。
 *
 * $ bash tools/check.sh g3-ph02 r04
 */
import fsguard::FsGuardOps;
#include <stdio.h>
#include <string.h>
#include <fcntl.h>
#include <unistd.h>

static int total = 0;
static int failed = 0;

static void check(int cond, char *name)
{
    total = total + 1;
    if (cond) {
        printf("ok %d %s\n", total, name);
    } else {
        failed = failed + 1;
        printf("not ok %d %s\n", total, name);
    }
}

static int write_bytes(char *path, char *data, int len)
{
    int fd;
    int put = 0;

    fd = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
    if (fd < 0) return -1;
    while (put < len) {
        int n = (int)write(fd, data + put, (size_t)(len - put));
        if (n <= 0) {
            close(fd);
            return -1;
        }
        put += n;
    }
    close(fd);
    return 0;
}

int main(void)
{
    char path[128];
    char data[300];
    char buf[128];
    char *p;
    int i;
    int n;

    strcpy(path, "/tmp/fsguard_ph02_chunk.bin");
    unlink(path);
    for (i = 0; i < 300; i++) data[i] = (char)(i % 256);
    if (write_bytes(path, data, 300) != 0) {
        printf("not ok 1 fixture setup\n");
        return 1;
    }
    p = path;

    memset(buf, 0, sizeof(buf));
    n = p.read_chunk(0, buf, 100);
    check(n == 100 && memcmp(buf, data, 100) == 0, "read_chunk(0,100) returns 100 by bytes");

    memset(buf, 0, sizeof(buf));
    n = p.read_chunk(100, buf, 100);
    check(n == 100 && memcmp(buf, data + 100, 100) == 0, "read_chunk(100,100) reads the right window");

    check(p.read_chunk(300, buf, 100) == 0, "offset == size returns 0 (EOF)");
    check(p.read_chunk(400, buf, 100) == 0, "offset > size returns 0 (EOF)");
    check(p.read_chunk(-1, buf, 100) == -1, "negative offset returns -1");
    check(p.read_chunk(0, buf, 0) == 0, "len == 0 returns 0");

    memset(buf, 0xFF, sizeof(buf));
    n = p.read_chunk(0, buf, 4);
    check(n == 4 && (unsigned char)buf[0] == 0 && buf[1] == 1 &&
          (unsigned char)buf[2] == 2 && buf[3] == 3,
          "embedded NUL bytes are preserved (binary safe)");

    check(p.read_chunk(0, buf, 4000) == 300, "short read at EOF returns the actual byte count");

    unlink(path);
    if (failed == 0) {
        printf("all checks passed\n");
        return 0;
    }
    printf("%d of %d checks failed\n", failed, total);
    return 1;
}
